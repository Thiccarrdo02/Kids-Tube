# Admin login password (any string you choose)
ADMIN_PASSWORD=changeme

# 32+ character random secret for cookie signing
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-32-plus-char-random-string

# YouTube Data API v3 key (from Google Cloud Console)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Supabase (free tier) -- get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres connection string (Transaction Pooler, port 6543).
# Get from: Supabase dashboard -> Settings -> Database -> Connection string ->
# choose "Transaction" mode and "URI" -> copy the full postgresql:// URL.
# Required ONCE so the admin can auto-create its tables on first run.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres
